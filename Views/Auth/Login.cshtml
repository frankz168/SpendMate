@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - SpendMate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0f172a;
            --primary-accent: #6366f1;
            --secondary-accent: #8b5cf6;
            --text-dark: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: rgba(255, 255, 255, 0.1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.2) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(139, 92, 246, 0.2) 0px, transparent 50%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
        }

        .login-card {
            background-color: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 420px;
            padding: 48px 40px;
            text-align: center;
            animation: float 6s ease-in-out infinite;
        }

        @@keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }

        .logo-circle {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--primary-accent), var(--secondary-accent));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 36px;
            box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.5);
        }

        .app-title {
            font-size: 28px;
            font-weight: 800;
            background: linear-gradient(to right, #fff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
        }

        .app-subtitle {
            color: var(--text-muted);
            font-size: 14px;
            margin-bottom: 32px;
            font-weight: 400;
        }

        .form-control-custom {
            background-color: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 14px 16px;
            font-size: 14px;
            color: var(--text-dark);
            width: 100%;
            transition: all 0.3s ease;
            margin-bottom: 16px;
        }

        .form-control-custom::placeholder {
            color: var(--text-muted);
            opacity: 0.6;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--primary-accent);
            background-color: rgba(0, 0, 0, 0.4);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
        }

        .btn-primary-custom {
            background: linear-gradient(135deg, var(--primary-accent), var(--secondary-accent));
            color: white;
            border: none;
            border-radius: 14px;
            padding: 14px;
            font-weight: 600;
            width: 100%;
            margin-top: 8px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
            color: white;
        }

        .error-message {
            color: #ff8a8a;
            font-size: 13px;
            margin-bottom: 20px;
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 12px;
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <div class="login-card animate-zoom-in">
        <div class="logo-circle">
            💸
        </div>
        <div class="app-title">SpendMate</div>
        <div class="app-subtitle">Welcome back! Please login to your family account.</div>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form method="post" action="/Auth/Login">
            @if (ViewData["ReturnUrl"] != null)
            {
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            }
            
            <input type="text" name="username" class="form-control-custom" placeholder="Username (e.g. franky)" required autofocus autocomplete="off" />
            <input type="password" name="password" class="form-control-custom" placeholder="Password" required autocomplete="off" />
            
            <button type="submit" class="btn-primary-custom">Sign In</button>
        </form>
    </div>

</body>
</html>
