@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - SpendMate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #040404;
            --primary-accent: #0a84ff;
            --secondary-accent: #32d74b;
            --text-dark: #ffffff;
            --text-muted: rgba(255, 255, 255, 0.55);
            --border-color: rgba(255, 255, 255, 0.08);
        }

        body.light-mode {
            --bg-color: #f2f2f7;
            --text-dark: #1c1c1e;
            --text-muted: rgba(0, 0, 0, 0.55);
            --border-color: rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
        }

        .login-card {
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.01) 100%);
            backdrop-filter: blur(45px) saturate(150%);
            -webkit-backdrop-filter: blur(45px) saturate(150%);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-top: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 24px;
            box-shadow: 0 24px 48px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.15);
            width: 100%;
            max-width: 420px;
            padding: 48px 40px;
            text-align: center;
            animation: float 6s ease-in-out infinite;
        }

        body.light-mode .login-card {
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.4) 100%);
            border: 1px solid rgba(255, 255, 255, 1);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.05), inset 0 1px 1px rgba(255, 255, 255, 1);
        }

        @@keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }

        .logo-circle {
            width: 80px;
            height: 80px;
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 36px;
            color: var(--text-dark);
        }

        body.light-mode .logo-circle {
            background-color: rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.1);
        }

        .login-theme-toggle {
            position: absolute;
            top: 24px;
            right: 24px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-dark);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            z-index: 100;
        }

        .login-theme-toggle:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(1.05);
        }

        body.light-mode .login-theme-toggle {
            background: rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.1);
        }

        body.light-mode .login-theme-toggle:hover {
            background: rgba(0, 0, 0, 0.1);
        }

        .app-title {
            font-size: 28px;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 8px;
            letter-spacing: -0.02em;
        }

        .app-subtitle {
            color: var(--text-muted);
            font-size: 14px;
            margin-bottom: 32px;
            font-weight: 400;
        }

        .form-control-custom {
            background-color: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 14px 16px;
            font-size: 14px;
            color: var(--text-dark);
            width: 100%;
            transition: all 0.3s ease;
            margin-bottom: 16px;
        }

        .form-control-custom::placeholder {
            color: var(--text-muted);
            opacity: 0.6;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--primary-accent);
            background-color: rgba(0, 0, 0, 0.4);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
        }

        .btn-primary-custom {
            background-color: var(--primary-accent);
            color: white;
            border: none;
            border-radius: 14px;
            padding: 14px;
            font-weight: 600;
            width: 100%;
            margin-top: 8px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(10, 132, 255, 0.25);
        }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(10, 132, 255, 0.4);
            color: white;
        }

        .error-message {
            color: #ff8a8a;
            font-size: 13px;
            margin-bottom: 20px;
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 12px;
            border-radius: 10px;
        }
    </style>
    <script>
        if (localStorage.getItem("lightMode") === "true") {
            document.documentElement.classList.add("light-mode");
        }

        function toggleLoginTheme() {
            const body = document.body;
            body.classList.toggle("light-mode");
            const isLight = body.classList.contains("light-mode");
            localStorage.setItem("lightMode", isLight);
            
            const icon = document.getElementById("themeIcon");
            if (isLight) {
                icon.setAttribute("name", "moon-outline");
            } else {
                icon.setAttribute("name", "sunny-outline");
            }
        }
        
        document.addEventListener("DOMContentLoaded", () => {
            const isLight = document.body.classList.contains("light-mode");
            const icon = document.getElementById("themeIcon");
            if (isLight && icon) icon.setAttribute("name", "moon-outline");
        });
    </script>
</head>
<body onload="if (localStorage.getItem('lightMode') === 'true') document.body.classList.add('light-mode');">

    <button class="login-theme-toggle" onclick="toggleLoginTheme()" title="Toggle Theme">
        <ion-icon id="themeIcon" name="sunny-outline"></ion-icon>
    </button>

    <div class="login-card animate-zoom-in">
        <div class="logo-circle">
            <ion-icon name="wallet-outline"></ion-icon>
        </div>
        <div class="app-title">SpendMate</div>
        <div class="app-subtitle">Welcome back! Please login to your family account.</div>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form method="post" action="/Auth/Login">
            @if (ViewData["ReturnUrl"] != null)
            {
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            }
            
            <input type="text" name="username" class="form-control-custom" placeholder="Username (e.g. franky)" required autofocus autocomplete="off" />
            <input type="password" name="password" class="form-control-custom" placeholder="Password" required autocomplete="off" />
            
            <button type="submit" class="btn-primary-custom">Sign In</button>
        </form>
    </div>

    <!-- Ionicons Setup -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>
</html>
