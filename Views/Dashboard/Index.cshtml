@model DailySummaryVM

@{
    ViewBag.Title = "SpendMate Dashboard";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="page-title mt-2"><ion-icon name="grid-outline" style="vertical-align: -3px;"></ion-icon> Dashboard</div>
<p class="text-muted mb-4">Welcome back! Here is your financial overview.</p>

<!-- WARNING ALERT -->
@if (Model.RemainingBudget < 0)
{
    <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center mb-4" role="alert" style="border-radius: 12px;">
        <span class="fs-4 me-3 d-flex"><ion-icon name="warning-outline"></ion-icon></span>
        <div>
            <strong>Warning!</strong> You have exceeded your monthly expense budget by <b>Rp @Math.Abs(Model.RemainingBudget).ToString("N0")</b>.
        </div>
    </div>
}

<!-- KEY METRICS ROW -->
<div class="row g-4 mb-4">
    
    <!-- MONTHLY INCOME -->
    <div class="col-md-3">
        <div class="theme-card h-100 d-flex flex-column justify-content-center">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-muted mb-0" style="font-size: 13px; font-weight: 600;">Income This Month</h6>
                <span class="fs-5 d-flex"><ion-icon name="wallet-outline"></ion-icon></span>
            </div>
            <h4 class="fw-bold text-success-custom mb-0 animate-number" data-target="@Model.MonthlyIncome" data-prefix="Rp ">
                Rp @Model.MonthlyIncome.ToString("N0")
            </h4>
        </div>
    </div>

    <!-- MONTHLY EXPENSE -->
    <div class="col-md-3">
        <div class="theme-card h-100 d-flex flex-column justify-content-center">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-muted mb-0" style="font-size: 13px; font-weight: 600;">Expense This Month</h6>
                <span class="fs-5 d-flex"><ion-icon name="cash-outline"></ion-icon></span>
            </div>
            <h4 class="fw-bold text-danger-custom mb-0 animate-number" data-target="@Model.MonthlyExpense" data-prefix="Rp ">
                Rp @Model.MonthlyExpense.ToString("N0")
            </h4>
        </div>
    </div>

    <!-- NET BALANCE -->
    <div class="col-md-3">
        <div class="theme-card h-100 d-flex flex-column justify-content-center">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-muted mb-0" style="font-size: 13px; font-weight: 600;">Net Balance</h6>
                <span class="fs-5 d-flex"><ion-icon name="scale-outline"></ion-icon></span>
            </div>
            <h4 class="fw-bold text-primary mb-0 animate-number" style="color: var(--primary-green) !important;" data-target="@Model.NetBalance" data-prefix="Rp ">
                Rp @Model.NetBalance.ToString("N0")
            </h4>
        </div>
    </div>

    <!-- BUDGET REMAINING -->
    <div class="col-md-3">
        <div class="theme-card h-100 d-flex flex-column justify-content-center">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-muted mb-0" style="font-size: 13px; font-weight: 600;">Budget Remaining</h6>
                <span class="fs-5 d-flex"><ion-icon name="bullseye-outline"></ion-icon></span>
            </div>
            <h4 class="fw-bold mb-2 @(Model.RemainingBudget < 0 ? "text-danger-custom" : "") animate-number" data-target="@Model.RemainingBudget" data-prefix="Rp ">
                Rp @Model.RemainingBudget.ToString("N0")
            </h4>

            @{
                var percent = Model.Budget == 0 ? 0m : (decimal)Model.MonthlyExpense / (decimal)Model.Budget * 100m;
                var percentSafe = percent > 100 ? 100 : percent;
                var widthValue = percentSafe.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            }

            <div class="progress mt-auto shadow-sm" style="height: 8px; border-radius: 4px; background: #e5e7eb;">
                <div class="progress-bar @(percent > 100 ? "bg-danger" : "")"
                     role="progressbar"
                     style="width:@widthValue%; @(percent <= 100 ? "background: linear-gradient(135deg, var(--primary-accent), var(--secondary-accent));" : "") border-radius: 4px;">
                </div>
            </div>
        </div>
    </div>

</div>

<!-- MAIN DASHBOARD AREA -->
<div class="row g-4 mb-5">
    
    <!-- CHART -->
    <div class="col-lg-5">
        <div class="theme-card h-100 d-flex flex-column">
            <h6 class="fw-bold text-dark mb-4 d-flex align-items-center" style="font-size: 16px;"><ion-icon name="pie-chart-outline" class="me-2 fs-5"></ion-icon> This Month's Expense Distribution</h6>
            @if (Model.Items != null && Model.Items.Count > 0)
            {
                <div class="flex-grow-1 d-flex justify-content-center align-items-center" style="position: relative; height: 250px;">
                    <canvas id="expenseChart"></canvas>
                </div>
            }
            else
            {
                <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-muted">
                    <span class="fs-1 mb-2 d-flex"><ion-icon name="bed-outline"></ion-icon></span>
                    <p>No expenses recorded today.</p>
                </div>
            }
        </div>
    </div>

    <!-- BREAKDOWN TABLE -->
    <div class="col-lg-7">
        <div class="theme-card h-100 d-flex flex-column">
            <h6 class="fw-bold mb-3 d-flex align-items-center" style="font-size: 16px;"><ion-icon name="list-outline" class="me-2 fs-5"></ion-icon> This Month's Expense Breakdown</h6>

            @if (Model.Items != null && Model.Items.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0 border-0">
                        <thead>
                            <tr>
                                <th class="border-0" style="font-weight: 600; font-size: 13px; color: var(--text-muted);">Category</th>
                                <th class="border-0 text-end" style="font-weight: 600; font-size: 13px; color: var(--text-muted);">Total (Rp)</th>
                                <th class="border-0 text-center" style="font-weight: 600; font-size: 13px; color: var(--text-muted);">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-bold py-3 border-bottom" style="border-color: var(--border-color) !important; color: var(--text-dark);">
                                        <span class="fs-5 me-3 d-inline-flex" style="vertical-align: -2px;">@Html.Raw(GetIcon(item.Category))</span> @item.Category
                                    </td>
                                    <td class="text-end fw-bold py-3 border-bottom" style="border-color: var(--border-color) !important;">
                                        @item.Total.ToString("N0")
                                    </td>
                                    <td class="text-center py-3 border-bottom" style="border-color: var(--border-color) !important;">
                                        <button class="btn btn-sm fw-bold d-inline-flex align-items-center" style="background-color: rgba(255,255,255,0.1); color: var(--text-dark); border-radius: 8px;" onclick="openCategory('@item.Category')">
                                            View Details <ion-icon name="arrow-forward-outline" class="ms-1"></ion-icon>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-muted">
                    <p class="mb-0">Your wallet is taking a rest today.</p>
                </div>
            }
        </div>
    </div>

</div>

<!-- TREND CHART (LAST 6 MONTHS) -->
<div class="row mb-5">
    <div class="col-12">
        <div class="theme-card">
            <h6 class="fw-bold text-dark mb-4 d-flex align-items-center" style="font-size: 16px;"><ion-icon name="trending-up-outline" class="me-2 fs-5"></ion-icon> 6-Month Income vs Expense Trend</h6>
            @if (Model.TrendItems != null && Model.TrendItems.Count > 0)
            {
                <div style="position: relative; height: 350px; width: 100%;">
                    <canvas id="trendChart"></canvas>
                </div>
            }
            else
            {
                <div class="d-flex flex-column justify-content-center align-items-center text-muted" style="height: 350px;">
                    <p>No historical data available.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ================= SCRIPTS ================= -->
<script>
    let myChart = null;

    // ================= GLOBAL CHART CONFIG =================
    const getChartColors = () => {
        const isLight = document.body.classList.contains('light-mode');
        return {
            text: isLight ? '#1c1c1e' : '#f8fafc',
            muted: isLight ? '#64748b' : '#94a3b8',
            grid: isLight ? 'rgba(0,0,0,0.05)' : 'rgba(255,255,255,0.05)'
        };
    };

    function initChart() {
        const labels = @Html.Raw(Model.Items != null ? "[" + string.Join(",", Model.Items.Select(x => $"\"{x.Category}\"")) + "]" : "[]");
        const values = @Html.Raw(Model.Items != null ? "[" + string.Join(",", Model.Items.Select(x => x.Total.ToString(System.Globalization.CultureInfo.InvariantCulture))) + "]" : "[]");
        
        if(labels.length === 0) return;

        const ctx = document.getElementById('expenseChart').getContext('2d');
        const colors = getChartColors();

        // Vibrant colors matching the cool theme
        const bgColors = ['#6366f1', '#8b5cf6', '#0ea5e9', '#d946ef', '#f43f5e', '#14b8a6'];

        if (myChart) myChart.destroy();

        myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: values,
                    backgroundColor: bgColors,
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                circumference: 0, // Start empty
                rotation: 270,    // Start drawing from the top (12 o'clock)
                animations: {
                    circumference: {
                        duration: 2000,
                        easing: 'easeOutQuart'
                    }
                },
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            color: colors.text,
                            font: { family: "'Inter', sans-serif", size: 13, weight: '500' }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let value = context.raw || 0;
                                return ' Rp ' + new Intl.NumberFormat('id-ID').format(value);
                            }
                        }
                    }
                }
            }
        });

        // Trigger the loading animation (fill from 0 to 360)
        setTimeout(() => {
            if (myChart) {
                myChart.options.circumference = 360;
                myChart.update();
            }
        }, 50);
    }

    // CATEGORY DRILL DOWN
    function openCategory(category) {
        const from = new Date();
        from.setDate(1);
        from.setHours(0,0,0,0);

        const to = new Date(from.getFullYear(), from.getMonth() + 1, 0);
        to.setHours(23,59,59,999);

        window.location.href = `/Transaction/List?category=${encodeURIComponent(category)}&from=${from.toISOString()}&to=${to.toISOString()}`;
    }

    document.addEventListener("DOMContentLoaded", () => {
        initChart();
        initTrendChart();
        
        // NUMBER ANIMATION
        const animateValue = (obj, start, end, duration, prefix) => {
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                
                // easeOutExpo
                const easeProgress = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
                
                const current = start + (end - start) * easeProgress;
                obj.innerHTML = prefix + new Intl.NumberFormat('id-ID').format(Math.round(current));
                
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                } else {
                    obj.innerHTML = prefix + new Intl.NumberFormat('id-ID').format(end);
                }
            };
            window.requestAnimationFrame(step);
        };

        document.querySelectorAll('.animate-number').forEach(el => {
            const target = parseFloat(el.getAttribute('data-target')) || 0;
            const prefix = el.getAttribute('data-prefix') || 'Rp ';
            animateValue(el, 0, target, 1500, prefix);
        });
    });

    function initTrendChart() {
        const trendLabels = @Html.Raw(Model.TrendItems != null ? "[" + string.Join(",", Model.TrendItems.Select(x => $"\"{x.Month}\"")) + "]" : "[]");
        const incomeData = @Html.Raw(Model.TrendItems != null ? "[" + string.Join(",", Model.TrendItems.Select(x => x.Income.ToString(System.Globalization.CultureInfo.InvariantCulture))) + "]" : "[]");
        const expenseData = @Html.Raw(Model.TrendItems != null ? "[" + string.Join(",", Model.TrendItems.Select(x => x.Expense.ToString(System.Globalization.CultureInfo.InvariantCulture))) + "]" : "[]");

        if(trendLabels.length === 0) return;

        const ctx = document.getElementById('trendChart')?.getContext('2d');
        if(!ctx) return;

        const colors = getChartColors();

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: trendLabels,
                datasets: [
                    {
                        label: 'Income',
                        data: incomeData,
                        backgroundColor: '#6366f1', 
                        borderRadius: 4
                    },
                    {
                        label: 'Expense',
                        data: expenseData,
                        backgroundColor: '#f43f5e',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    y: {
                        duration: 1500,
                        easing: 'easeOutQuart'
                    }
                },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            color: colors.text,
                            font: { family: "'Inter', sans-serif", size: 13, weight: '500' }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let value = context.raw || 0;
                                return context.dataset.label + ': Rp ' + new Intl.NumberFormat('id-ID').format(value);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: colors.muted },
                        grid: { color: colors.grid }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: colors.grid },
                        ticks: {
                            color: colors.muted,
                            callback: function(value) {
                                if (value === 0) return '0';
                                return 'Rp ' + (value / 1000) + 'k';
                            }
                        }
                    }
                }
            }
        });
    }

</script>

@functions {
    public string GetIcon(string category)
    {
        var cat = category?.ToUpperInvariant() ?? "";
        if (cat.Contains("DINING") || cat.Contains("FOOD") || cat.Contains("EAT")) return "<ion-icon name=\"restaurant-outline\"></ion-icon>";
        if (cat.Contains("TRANSPORT") || cat.Contains("GAS") || cat.Contains("CAR")) return "<ion-icon name=\"car-outline\"></ion-icon>";
        if (cat.Contains("SHOPPING")) return "<ion-icon name=\"bag-handle-outline\"></ion-icon>";
        if (cat.Contains("GROCERIES") || cat.Contains("GROCERY")) return "<ion-icon name=\"cart-outline\"></ion-icon>";
        if (cat.Contains("ELECTRIC") || cat.Contains("PLN")) return "<ion-icon name=\"flash-outline\"></ion-icon>";
        if (cat.Contains("WATER") || cat.Contains("PAM")) return "<ion-icon name=\"water-outline\"></ion-icon>";
        if (cat.Contains("PARENTS") || cat.Contains("FAMILY")) return "<ion-icon name=\"people-outline\"></ion-icon>";
        if (cat.Contains("INTERNET") || cat.Contains("KUOTA") || cat.Contains("WIFI")) return "<ion-icon name=\"wifi-outline\"></ion-icon>";
        if (cat.Contains("LAUNDRY") || cat.Contains("WASH")) return "<ion-icon name=\"shirt-outline\"></ion-icon>";
        if (cat.Contains("TABUNGAN") || cat.Contains("INVEST") || cat.Contains("DANA")) return "<ion-icon name=\"trending-up-outline\"></ion-icon>";
        if (cat.Contains("ENSURANCE") || cat.Contains("INSURANCE")) return "<ion-icon name=\"shield-checkmark-outline\"></ion-icon>";
        if (cat.Contains("KAKAVEST")) return "<ion-icon name=\"wallet-outline\"></ion-icon>";
        if (cat.Contains("GOLD") || cat.Contains("ANTAM")) return "<ion-icon name=\"medal-outline\"></ion-icon>";
        if (cat.Contains("RECREATION") || cat.Contains("HOLIDAY") || cat.Contains("VACATION")) return "<ion-icon name=\"airplane-outline\"></ion-icon>";
        if (cat.Contains("SALARY") || cat.Contains("INCOME")) return "<ion-icon name=\"cash-outline\"></ion-icon>";
        if (cat.Contains("BONUS") || cat.Contains("GIFT")) return "<ion-icon name=\"gift-outline\"></ion-icon>";
        return "<ion-icon name=\"cube-outline\"></ion-icon>";
    }
}