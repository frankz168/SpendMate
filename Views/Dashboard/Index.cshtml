@model DailySummaryVM

@{
    ViewBag.Title = "SpendMate Dashboard";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📊 Dashboard</h2>

        <button class="btn btn-sm btn-outline-dark" onclick="toggleDarkMode()">
            🌙 Toggle Dark
        </button>
    </div>

    <!-- TODAY TOTAL -->
    <div class="card mb-4 shadow-sm theme-card">
        <div class="card-body">
            <h6 class="text-muted">Today's Total</h6>
            <h2 class="fw-bold">
                Rp @Model.Total.ToString("N0")
            </h2>
        </div>
    </div>

    <!-- MONTHLY BUDGET -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm theme-card">
                <div class="card-body">
                    <h6 class="text-muted">Monthly Budget</h6>
                    <h5 class="fw-bold">
                        Rp @Model.Budget.ToString("N0")
                    </h5>
                </div>
            </div>
        </div>

        <!-- USED THIS MONTH -->
        <div class="col-md-4">
            <div class="card shadow-sm theme-card">
                <div class="card-body">
                    <h6 class="text-muted">Used This Month</h6>
                    <h5 class="fw-bold">
                        Rp @Model.MonthlyTotal.ToString("N0")
                    </h5>

                    @{
                        var percent = Model.Budget == 0
                            ? 0m
                            : (decimal)Model.MonthlyTotal / (decimal)Model.Budget * 100m;

                        var percentSafe = percent > 100 ? 100 : percent;

                        var widthValue = percentSafe.ToString("0.##",
                            System.Globalization.CultureInfo.InvariantCulture);
                    }

                    <div class="progress mt-2 premium-progress">
                        <div class="progress-bar premium-bar @(percent > 100 ? "danger" : "normal")"
                             role="progressbar"
                             style="width:@widthValue%">
                        </div>

                        <div class="progress-text">
                            @percent.ToString("0")%
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- REMAINING -->
        <div class="col-md-4">
            <div class="card shadow-sm theme-card">
                <div class="card-body">
                    <h6 class="text-muted">Remaining Budget</h6>
                    <h5 class="fw-bold @(Model.Remaining < 0 ? "text-danger" : "text-success")">
                        Rp @Model.Remaining.ToString("N0")
                    </h5>
                </div>
            </div>
        </div>

    </div>

    <!-- WARNING -->
    @if (Model.Remaining < 0)
    {
        <div class="alert alert-danger">
            ⚠️ You have exceeded your monthly budget!
        </div>
    }

    <!-- CHART -->
    <div class="card mb-4 shadow-sm theme-card">
        <div class="card-body">
            <h6 class="mb-3">Expense Visualization</h6>
            <canvas id="expenseChart" height="120"></canvas>
        </div>
    </div>

    <!-- BREAKDOWN (CLICKABLE UPGRADE) -->
    <div class="card shadow-sm theme-card">
        <div class="card-body">
            <h6 class="mb-3">Today's Expense Breakdown</h6>

            @if (Model.Items != null && Model.Items.Count > 0)
            {
                <table class="table table-sm table-hover">

                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr style="cursor:pointer"
                            onclick="openCategory('@item.Category')">

                            <td>
                                @GetIcon(item.Category) @item.Category
                            </td>

                            <td class="text-end fw-semibold">
                                Rp @item.Total.ToString("N0")
                            </td>
                        </tr>
                    }
                    </tbody>

                </table>
            }
            else
            {
                <p class="text-muted">No data for today</p>
            }
        </div>
    </div>

</div>

<!-- ================= CHART JS ================= -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    // SAFE DATA (avoid null crash)
    const labels = @Html.Raw(
        Model.Items != null
        ? "[" + string.Join(",", Model.Items.Select(x => $"\"{x.Category}\"")) + "]"
        : "[]"
    );

    const values = @Html.Raw(
        Model.Items != null
        ? "[" + string.Join(",", Model.Items.Select(x => x.Total.ToString(System.Globalization.CultureInfo.InvariantCulture))) + "]"
        : "[]"
    );

    const ctx = document.getElementById('expenseChart');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                data: values,
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    // CATEGORY DRILL DOWN
    function openCategory(category) {

        const from = new Date();
        from.setHours(0,0,0,0);

        const to = new Date();
        to.setHours(23,59,59,999);

        window.location.href =
            `/Expense/List?category=${encodeURIComponent(category)}`
            + `&from=${from.toISOString()}`
            + `&to=${to.toISOString()}`;
    }

    // DARK MODE
    function toggleDarkMode() {
        document.body.classList.toggle("dark-mode");

        localStorage.setItem(
            "darkMode",
            document.body.classList.contains("dark-mode")
        );
    }

    if (localStorage.getItem("darkMode") === "true") {
        document.body.classList.add("dark-mode");
    }

</script>

<!-- ================= STYLE ================= -->
<style>

    body.dark-mode {
        background: #121212;
        color: #eaeaea;
    }

    body.dark-mode .theme-card {
        background: #1e1e1e;
        color: #eaeaea;
        border: 1px solid #2a2a2a;
    }

    body.dark-mode .table {
        color: #eaeaea;
    }

    body.dark-mode .text-muted {
        color: #aaa !important;
    }

    /* ================= PREMIUM PROGRESS ================= */

    .premium-progress {
        position: relative;
        height: 22px;
        border-radius: 12px;
        background: rgba(0,0,0,0.08);
        overflow: hidden;
    }

    body.dark-mode .premium-progress {
        background: rgba(255,255,255,0.08);
    }

    .premium-bar {
        height: 100%;
        border-radius: 12px;
        transition: width 0.8s ease;
    }

    .premium-bar.normal {
        background: linear-gradient(90deg, #00c853, #64dd17);
        box-shadow: 0 0 10px rgba(0, 200, 83, 0.35);
    }

    .premium-bar.danger {
        background: linear-gradient(90deg, #ff3d00, #ff1744);
        box-shadow: 0 0 10px rgba(255, 23, 68, 0.35);
    }

    .progress-text {
        position: absolute;
        width: 100%;
        text-align: center;
        font-size: 11px;
        font-weight: 600;
        color: #fff;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }

</style>

@functions {
    public string GetIcon(string category)
    {
        return category switch
        {
            "Food" => "🍽️",
            "Transport" => "🚗",
            "Shopping" => "🛍️",
            _ => "📦"
        };
    }
}