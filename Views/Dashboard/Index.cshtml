@model DailySummaryVM

@{
    ViewBag.Title = "SpendMate Dashboard";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📊 Dashboard</h2>

        <button class="btn btn-sm btn-outline-dark" onclick="toggleDarkMode()">
            🌙 Toggle Dark
        </button>
    </div>

    <!-- TOTAL -->
    <div class="card mb-4 shadow-sm theme-card">
        <div class="card-body">
            <h6 class="text-muted">Total Hari Ini</h6>
            <h2 class="fw-bold">
                Rp @Model.Total.ToString("N0")
            </h2>
        </div>
    </div>

    <!-- CHART -->
    <div class="card mb-4 shadow-sm theme-card">
        <div class="card-body">
            <h6 class="mb-3">Visual Pengeluaran</h6>
            <canvas id="expenseChart" height="120"></canvas>
        </div>
    </div>

    <!-- BREAKDOWN -->
    <div class="card shadow-sm theme-card">
        <div class="card-body">
            <h6 class="mb-3">Breakdown Pengeluaran</h6>

            @if (Model.Items != null && Model.Items.Count > 0)
            {
                <table class="table table-sm">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@GetIcon(item.Category) @item.Category</td>
                            <td class="text-end fw-semibold">
                                Rp @item.Total.ToString("N0")
                            </td>
                        </tr>
                    }
                </table>
            }
            else
            {
                <p class="text-muted">Belum ada data hari ini</p>
            }
        </div>
    </div>

</div>

<!-- CHART JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const labels = [
        @foreach (var item in Model.Items)
        {
            @: "@item.Category",
        }
    ];

    const values = [
        @foreach (var item in Model.Items)
        {
            @: @item.Total,
        }
    ];

    const ctx = document.getElementById('expenseChart');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                data: values,
                borderWidth: 1
            }]
        },
        options: {
            plugins: {
                legend: { display: false }
            }
        }
    });

    // ================= DARK MODE =================
    function toggleDarkMode() {
        document.body.classList.toggle("dark-mode");

        localStorage.setItem(
            "darkMode",
            document.body.classList.contains("dark-mode")
        );
    }

    // load state
    if (localStorage.getItem("darkMode") === "true") {
        document.body.classList.add("dark-mode");
    }
</script>

<style>
    body.dark-mode {
        background: #121212;
        color: #eaeaea;
    }

    body.dark-mode .theme-card {
        background: #1e1e1e;
        color: #eaeaea;
        border: 1px solid #2a2a2a;
    }

    body.dark-mode .table {
        color: #eaeaea;
    }

    body.dark-mode .text-muted {
        color: #aaa !important;
    }
</style>

@functions {
    public string GetIcon(string category)
    {
        return category switch
        {
            "Makan" => "🍽️",
            "Transport" => "🚗",
            "Belanja" => "🛍️",
            _ => "📦"
        };
    }
}