@model DailySummaryVM

@{
    ViewBag.Title = "SpendMate - Input Expense";
}

<div class="container mt-4" style="max-width:700px;">

    <!-- TITLE -->
    <h2 class="mb-3">💸 SpendMate</h2>
    <p class="text-muted">Catat pengeluaran kamu dengan cepat & rapi</p>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success py-2">
            @TempData["Success"]
        </div>
    }

    <!-- INPUT CARD -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="post">

                <div class="row g-3">

                    <!-- AMOUNT -->
                    <div class="col-md-4">
                        <label class="form-label">Amount</label>
                        <input name="Amount"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="0"
                               required />
                    </div>

                    <!-- CATEGORY -->
                    <div class="col-md-4">
                        <label class="form-label">Category</label>
                        <select name="Category" class="form-select" required>
                            <option value="">Select</option>
                            <option value="Makan">🍽️ Makan</option>
                            <option value="Transport">🚗 Transport</option>
                            <option value="Belanja">🛍️ Belanja</option>
                            <option value="Lainnya">📦 Lainnya</option>
                        </select>
                    </div>

                    <!-- NOTE -->
                    <div class="col-md-4">
                        <label class="form-label">Note</label>
                        <input name="Note"
                               class="form-control"
                               placeholder="optional" />
                    </div>

                </div>

                <input type="hidden" name="UserId" value="1" />

                <!-- BUTTON -->
                <div class="mt-3 text-end">
                    <button class="btn btn-dark px-4">
                        Save Expense
                    </button>
                </div>

            </form>

        </div>
    </div>

    <!-- SUMMARY -->
    <div class="card shadow-sm">
        <div class="card-body">

            <h5>📊 Hari Ini</h5>

            <h3 class="fw-bold">
                Rp @Model.Total.ToString("N0")
            </h3>

            <hr />

            @if (Model.Items != null && Model.Items.Count > 0)
            {
                <table class="table table-sm">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @GetIcon(item.Category) @item.Category
                            </td>
                            <td class="text-end fw-semibold">
                                Rp @item.Total.ToString("N0")
                            </td>
                        </tr>
                    }
                </table>
            }
            else
            {
                <p class="text-muted">Belum ada pengeluaran hari ini</p>
            }

        </div>
    </div>

</div>

<script>
    const success = '@TempData["Success"]';
    if (success) {
        setTimeout(() => {
            document.querySelector("form").reset();
        }, 200);
    }
</script>

@functions {
    public string GetIcon(string category)
    {
        return category switch
        {
            "Makan" => "🍽️",
            "Transport" => "🚗",
            "Belanja" => "🛍️",
            _ => "📦"
        };
    }
}