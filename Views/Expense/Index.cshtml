@{
    ViewBag.Title = "SpendMate";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-4">

    <!-- TOP BAR -->
    <div class="d-flex justify-content-end mb-2 gap-2">
       <button class="btn btn-sm btn-outline-dark" onclick="toggleDarkMode()">
            🌙 Toggle Dark
        </button>
        <button class="btn btn-sm btn-success" onclick="exportExcel()">⬇️ Export Excel</button>
    </div>

    <!-- TITLE -->
    <div class="mb-4">
        <h2>💸 SpendMate</h2>
        <p class="text-muted">Input, edit, delete expense</p>
    </div>

    <!-- INPUT -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label>Category</label>
                    <select id="category" class="form-select">
                        <option value="">Select</option>
                        <option value="Food">🍽️ Food</option>
                        <option value="Transport">🚗 Transport</option>
                        <option value="Shopping">🛍️ Shopping</option>
                        <option value="Others">📦 Others</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label>Amount</label>
                    <input id="amount" type="number" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>Note</label>
                    <input id="note" class="form-control" />
                </div>

                <div class="col-md-1 d-grid">
                    <button id="btnSave" class="btn btn-dark" onclick="saveExpense()">+</button>
                </div>

            </div>
        </div>
    </div>

    <!-- DATE FILTER -->
    <div class="row mb-2">

        <div class="col-md-3">
            <label>From</label>
            <input id="fromDate" type="date" class="form-control" />
        </div>

        <div class="col-md-3">
            <label>To</label>
            <input id="toDate" type="date" class="form-control" />
        </div>

        <div class="col-md-2 d-grid">
            <label>&nbsp;</label>
            <button class="btn btn-primary" onclick="loadData()">Apply</button>
        </div>

        <div class="col-md-2 d-grid">
            <label>&nbsp;</label>
            <button class="btn btn-outline-secondary" onclick="setToday()">Today</button>
        </div>

    </div>

    <!-- QUICK RANGE -->
    <div class="mb-2">
        <button class="btn btn-sm btn-outline-dark" onclick="setRange(7)">Last 7 Days</button>
        <button class="btn btn-sm btn-outline-dark" onclick="setRange(30)">Last 30 Days</button>
    </div>

    <!-- FILTER -->
    <div class="row mb-2">

        <div class="col-md-4">
            <input id="searchBox" class="form-control" placeholder="Search..." oninput="applyFilter()" />
        </div>

        <div class="col-md-3">
            <select id="filterCategory" class="form-select" onchange="applyFilter()">
                <option value="">All Category</option>
                <option value="Food">Food</option>
                <option value="Transport">Transport</option>
                <option value="Shopping">Shopping</option>
                <option value="Others">Others</option>
            </select>
        </div>

    </div>

    <!-- TABLE -->
    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-sm table-bordered">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Note</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="expenseList"></tbody>
            </table>

            <!-- PAGINATION -->
            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-sm btn-outline-dark" onclick="prevPage()">◀</button>
                <div id="pageInfo"></div>
                <button class="btn btn-sm btn-outline-dark" onclick="nextPage()">▶</button>
            </div>

        </div>
    </div>

</div>

<script>
let editId = 0;
let allData = [];
let filteredData = [];
let currentPage = 1;
const pageSize = 25;

// ================= LOAD DATA
async function loadData() {

    const from = document.getElementById("fromDate").value;
    const to = document.getElementById("toDate").value;

    let url = '/Expense/GetData';

    if (from && to) {
        url += `?from=${from}&to=${to}`;
    }

    const res = await fetch(url);
    const data = await res.json();

    allData = data; // 🔥 FIXED
    filteredData = allData;

    currentPage = 1;
    renderTable();
}

// ================= TODAY
function setToday() {
    const today = new Date();

    const from = today.toISOString().split('T')[0];

    // add 1 day
    const tomorrowDate = new Date(today);
    tomorrowDate.setDate(tomorrowDate.getDate() + 1);
    const to = tomorrowDate.toISOString().split('T')[0];

    document.getElementById("fromDate").value = from;
    document.getElementById("toDate").value = to;

    loadData();
}

// ================= RANGE
function setRange(days) {
    const today = new Date();
    const from = new Date();
    from.setDate(today.getDate() - days);

    document.getElementById("fromDate").value = from.toISOString().split('T')[0];
    document.getElementById("toDate").value = today.toISOString().split('T')[0];

    loadData();
}

// ================= RENDER
function renderTable() {
    const start = (currentPage - 1) * pageSize;
    const pageData = filteredData.slice(start, start + pageSize);

    let rows = "";

    pageData.forEach(x => {
        rows += `
        <tr>
            <td>${formatTime(x.createdate)}</td>
            <td>${icon(x.category)} ${x.category}</td>
            <td>Rp ${format(x.amount)}</td>
            <td>${x.note ?? ""}</td>
            <td>
                <button class="btn btn-sm btn-warning" onclick="editExpense(${x.id})">Edit</button>
                <button class="btn btn-sm btn-danger" onclick="deleteExpense(${x.id})">Delete</button>
            </td>
        </tr>`;
    });

    document.getElementById("expenseList").innerHTML = rows;
    updatePageInfo();
}

// ================= FILTER
function applyFilter() {
    const search = document.getElementById("searchBox").value.toLowerCase();
    const category = document.getElementById("filterCategory").value;

    filteredData = allData.filter(x =>
        ((x.note ?? "").toLowerCase().includes(search) ||
         (x.category ?? "").toLowerCase().includes(search)) &&
        (!category || x.category === category)
    );

    currentPage = 1;
    renderTable();
}

// ================= PAGINATION
function nextPage() {
    if (currentPage * pageSize < filteredData.length) {
        currentPage++;
        renderTable();
    }
}

function prevPage() {
    if (currentPage > 1) {
        currentPage--;
        renderTable();
    }
}

function updatePageInfo() {
    const totalPage = Math.ceil(filteredData.length / pageSize);
    document.getElementById("pageInfo").innerText =
        `Page ${currentPage} / ${totalPage || 1}`;
}

// ================= SAVE
// ================= SAVE
async function saveExpense() {
    const category = document.getElementById("category").value;
    const amount = document.getElementById("amount").value;
    const note = document.getElementById("note").value;

    if (!category || !amount) {
        Swal.fire({
            icon: "warning",
            title: "Missing Data",
            text: "Category & Amount are required"
        });
        return;
    }

    try {
        const response = await fetch('/Expense/Save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                id: editId,
                userId: 1,
                category,
                amount: parseFloat(amount),
                note
            })
        });

        // DEBUG (optional)
        console.log("STATUS:", response.status);

        // ❗ CHECK RESPONSE
        if (!response.ok) {
            const text = await response.text(); // ambil error kalau ada
            console.error("SERVER ERROR:", text);
            throw new Error("Server error");
        }

        // ✅ SUCCESS
        Swal.fire({
            icon: "success",
            title: editId ? "Updated!" : "Saved!",
            text: editId
                ? "Expense updated successfully"
                : "Expense added successfully",
            timer: 1500,
            showConfirmButton: false
        });

        resetForm();
        loadData();

    } catch (err) {
        console.error("SAVE ERROR:", err);

        Swal.fire({
            icon: "error",
            title: "Error",
            text: "Failed to save expense"
        });
    }
}

// ================= EDIT
// ================= EDIT
async function editExpense(id) {
    try {
        const res = await fetch('/Expense/GetById?id=' + id);
        const x = await res.json();

        editId = x.id;
        category.value = x.category;
        amount.value = x.amount;
        note.value = x.note;

        Swal.fire({
            icon: "info",
            title: "Edit Mode",
            text: "You are now editing this expense"
        });

    } catch (err) {
        Swal.fire({
            icon: "error",
            title: "Error",
            text: "Failed to load data"
        });
    }
}

// ================= DELETE
async function deleteExpense(id) {
    const confirm = await Swal.fire({
        title: "Delete this expense?",
        text: "This action cannot be undone",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        confirmButtonText: "Yes, delete it",
        cancelButtonText: "Cancel"
    });

    if (!confirm.isConfirmed) return;

    try {
        await fetch('/Expense/Delete?id=' + id, { method: 'POST' });

        Swal.fire({
            icon: "success",
            title: "Deleted!",
            text: "Expense has been removed",
            timer: 1200,
            showConfirmButton: false
        });

        loadData();
    } catch (err) {
        Swal.fire("Error", "Failed to delete data", "error");
    }
}

// ================= HELPERS
function format(num) {
    return new Intl.NumberFormat('id-ID').format(num || 0);
}

function formatTime(date) {

    console.log("RAW DATE:", date);

    if (!date) {
        console.log("❌ date kosong/null");
        return "";
    }

    // handle kalau bukan string (misalnya sudah Date object)
    let safeDate = date;

    if (typeof date === "string") {
        safeDate = date.replace(" ", "T");
    }

    console.log("SAFE DATE:", safeDate);

    const d = new Date(safeDate);

    console.log("PARSED DATE:", d);

    if (isNaN(d)) {
        console.log("❌ INVALID DATE:", date);
        return date; // fallback tampil original
    }

    const formatted = d.toLocaleString('id-ID', {
        day: '2-digit',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit'
    });

    console.log("✅ FORMATTED:", formatted);

    return formatted;
}

function icon(cat) {
    return cat === "Food" ? "🍽️" :
           cat === "Transport" ? "🚗" :
           cat === "Shopping" ? "🛍️" : "📦";
}

function exportExcel() {
    const from = document.getElementById("fromDate").value;
    const to = document.getElementById("toDate").value;

    let url = '/Expense/ExportExcel';
    if (from && to) {
        url += `?from=${from}&to=${to}`;
    }

    window.location.href = url;
}

function resetForm() {
    editId = 0;

    document.getElementById("category").value = "";
    document.getElementById("amount").value = "";
    document.getElementById("note").value = "";

    // focus balik ke input pertama
    document.getElementById("category").focus();
}

// ================= INIT
setToday();

 // ================= DARK MODE =================
    function toggleDarkMode() {
        document.body.classList.toggle("dark-mode");

        localStorage.setItem(
            "darkMode",
            document.body.classList.contains("dark-mode")
        );
    }

    // load state
    if (localStorage.getItem("darkMode") === "true") {
        document.body.classList.add("dark-mode");
    }
</script>

<style>
    body.dark-mode {
        background: #121212;
        color: #eaeaea;
    }

    body.dark-mode .theme-card {
        background: #1e1e1e;
        color: #eaeaea;
        border: 1px solid #2a2a2a;
    }

    body.dark-mode .table {
        color: #eaeaea;
    }

    body.dark-mode .text-muted {
        color: #aaa !important;
    }
</style>