@{
    ViewData["Title"] = "SpendMate";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height:70vh;">

    <div class="text-center p-5 rounded-4 shadow-sm bg-white" style="max-width:600px; width:100%;">

        <!-- ICON -->
        <div style="font-size:48px;">💸</div>

        <!-- TITLE -->
        <h1 class="fw-bold mt-2">SpendMate</h1>

        <!-- SUBTITLE -->
        <p class="text-muted mt-2">
            Track pengeluaran kamu dengan cepat, simple, dan gak ribet.
        </p>

        <!-- FEATURE BADGES -->
        <div class="d-flex justify-content-center gap-2 flex-wrap mt-3">
            <span class="badge bg-light text-dark border">Fast Input</span>
            <span class="badge bg-light text-dark border">Smart Summary</span>
            <span class="badge bg-light text-dark border">Daily Insight</span>
        </div>

        <!-- BUTTONS -->
        <div class="mt-4 d-flex justify-content-center gap-2 flex-wrap">

            <a href="/Dashboard"
               class="btn btn-dark px-4 py-2 rounded-3 shadow-sm">
                📊 Dashboard
            </a>

            <a href="/Expense"
               class="btn btn-outline-dark px-4 py-2 rounded-3">
                ➕ Input Expense
            </a>

            <a href="/Report"
                class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">
                    📧 Report
            </a>
        </div>

        <!-- FOOT NOTE -->
        <p class="text-muted mt-4" style="font-size:12px;">
            Built to help you stop over-spending without thinking too much.
        </p>

    </div>

</div>