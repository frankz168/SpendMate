@model SettingsViewModel

@{
    ViewData["Title"] = "Settings & Master Data";
    var activeCategories = Model.Categories.Where(c => c.IsActive).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0">Settings & Master Data</h2>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <!-- Income Config -->
        <div class="theme-card p-4 h-100">
            <h5 class="fw-bold mb-3">Global Configuration</h5>
            <form method="post" action="/Settings/SaveIncome">
                <div class="form-group-custom mb-3 border-bottom pb-2">
                    <label class="text-muted mb-1">Monthly Target Income (Rp)</label>
                    <input type="number" name="targetAmount" class="form-control-custom w-100 bg-transparent text-dark shadow-none p-0 fs-4 fw-bold" value="@Model.MonthlyIncomeTarget" />
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm mt-3">Save Income</button>
            </form>
        </div>
    </div>
    
    <div class="col-md-8 mb-4">
        <!-- Categories -->
        <div class="theme-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Master Categories</h5>
                <button class="btn btn-sm btn-primary shadow-sm fw-bold" onclick="openCatModal(0, '', 'Variable', 0)">+ Add Category</button>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Group</th>
                            <th class="text-end">Default Target</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var cat in activeCategories)
                        {
                            <tr>
                                <td class="fw-bold">@cat.Name</td>
                                <td><span class="badge bg-secondary">@cat.GroupType</span></td>
                                <td class="text-end font-monospace">@cat.DefaultTarget.ToString("N0")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary me-1" onclick="openCatModal(@cat.Id, '@cat.Name', '@cat.GroupType', @cat.DefaultTarget)">Edit</button>
                                    <form method="post" action="/Settings/DeleteCategory" class="d-inline">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Disable this category?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade custom-modal" id="catModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="/Settings/SaveCategory">
                <input type="hidden" id="cId" name="Id" value="0" />
                <div class="modal-header d-flex justify-content-between border-0">
                    <button type="button" class="btn btn-link text-success-custom text-decoration-none fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-link text-success-custom text-decoration-none fw-bold">Save</button>
                </div>
                <div class="modal-body pt-0">
                    <div class="text-center mb-4">
                        <small class="text-muted fw-bold">CATEGORY</small>
                    </div>
                    
                    <div class="form-group-custom mb-3 border-bottom pb-2">
                        <label class="text-muted mb-1">Name</label>
                        <input type="text" id="cName" name="Name" class="form-control-custom w-100 bg-transparent text-dark shadow-none p-0 fw-bold" required />
                    </div>

                    <div class="form-group-custom mb-3 border-bottom pb-2">
                        <label class="text-muted mb-1">Group</label>
                        <select id="cGroup" name="GroupType" class="form-control-custom w-100 bg-transparent text-dark shadow-none p-0 fw-bold">
                            <option value="Fixed">Fixed Expenses</option>
                            <option value="Savings">Savings & Investments</option>
                            <option value="Variable">Variable Expenses</option>
                        </select>
                    </div>

                    <div class="form-group-custom mb-3 border-bottom pb-2">
                        <label class="text-muted mb-1">Default Monthly Target</label>
                        <input type="number" id="cTarget" name="DefaultTarget" class="form-control-custom w-100 bg-transparent text-dark shadow-none p-0 fs-4 fw-bold" value="0" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openCatModal(id, name, group, target) {
        document.getElementById('cId').value = id;
        document.getElementById('cName').value = name;
        document.getElementById('cGroup').value = group;
        document.getElementById('cTarget').value = target;
        new bootstrap.Modal(document.getElementById('catModal')).show();
    }
</script>
