<!DOCTYPE html>
<html lang="en">
@inject ICategoryRepository CatRepo
@{
    var categories = CatRepo.GetAll().Where(c => c.IsActive).ToList();
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpendMate</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <!-- Prevent Flash of Theme -->
    <script>
        if (localStorage.getItem("lightMode") === "true") {
            document.body.classList.add("light-mode");
        }
    </script>

    <div class="app-container">
        <!-- MOBILE HEADER -->
        <div class="mobile-header">
            <h4 class="mb-0 fw-bold" style="background: linear-gradient(to right, var(--primary-accent), var(--secondary-accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">SpendMate</h4>
            <button class="hamburger-btn" onclick="toggleSidebar()">☰</button>
        </div>

        <!-- SIDEBAR BACKDROP -->
        <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar" id="appSidebar">
            <div class="d-flex justify-content-between align-items-center mb-2 mt-md-0 mt-3">
                <h3 class="mb-0 fw-bold" style="color: var(--text-dark);">SpendMate</h3>
                <button class="hamburger-btn d-md-none" onclick="toggleSidebar()">✕</button>
            </div>
            
            <button class="btn w-100 d-flex align-items-center justify-content-center gap-2 mb-3 mt-2 shadow-sm theme-toggle-btn" onclick="toggleGlobalTheme()">
                <span id="globalThemeIcon"><ion-icon name="sunny-outline"></ion-icon></span> Toggle Theme
            </button>

            <div class="user-profile">
                <div class="avatar">
                    @(Context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div class="info">
                    <p class="name">@(Context.User.Identity?.Name ?? "User")</p>
                    <p class="role">Family Account</p>
                </div>
                <form action="/Auth/Logout" method="get" class="m-0 p-0">
                    <button type="submit" class="logout-btn d-flex align-items-center" title="Logout" style="background:transparent; border:none; color: var(--text-muted); font-size: 20px;">
                        <ion-icon name="log-out-outline"></ion-icon>
                    </button>
                </form>
            </div>
            
            <nav class="d-flex flex-column gap-2 mt-4">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" 
                   asp-controller="Dashboard" asp-action="Index">
                    <span class="fs-5 d-flex"><ion-icon name="home-outline"></ion-icon></span> Dashboard
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transaction" ? "active" : "")" 
                   asp-controller="Transaction" asp-action="Index">
                    <span class="fs-5 d-flex"><ion-icon name="document-text-outline"></ion-icon></span> All Transactions
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budget" ? "active" : "")" 
                   asp-controller="Budget" asp-action="Index">
                    <span class="fs-5 d-flex"><ion-icon name="pie-chart-outline"></ion-icon></span> Monthly Recap
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")" 
                   asp-controller="Report" asp-action="Index">
                    <span class="fs-5 d-flex"><ion-icon name="time-outline"></ion-icon></span> Reports
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Log" ? "active" : "")" 
                   asp-controller="Log" asp-action="Index">
                    <span class="fs-5 d-flex"><ion-icon name="terminal-outline"></ion-icon></span> System Logs
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")" 
                   asp-controller="User" asp-action="Index">
                    <span class="fs-5 d-flex"><ion-icon name="people-outline"></ion-icon></span> User Management
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" 
                   asp-controller="Settings" asp-action="Index">
                    <span class="fs-5 d-flex"><ion-icon name="settings-outline"></ion-icon></span> Settings
                </a>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <!-- FLOATING ACTION BUTTON (Optional if they want to keep original inline form, but FAB is part of the "cool" UI. The user said "don't remove original function". The inline form has "Destination" field which I missed in the FAB. I will include the modal but ensure it has all original fields.) -->
    <!-- Actually, if I keep the inline form in Transaction page, I can just leave this out or let the FAB open the modal. I'll include the modal but make sure it works. -->
    <button class="fab" data-bs-toggle="modal" data-bs-target="#addTransactionModal" onclick="resetModalForm()">
        <ion-icon name="add-outline"></ion-icon>
    </button>

    <!-- ADD TRANSACTION MODAL -->
    <div class="modal fade custom-modal" id="addTransactionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-link text-success-custom text-decoration-none fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-link text-success-custom text-decoration-none fw-bold" onclick="saveGlobalTransaction()">Save</button>
                </div>
                <div class="modal-body pt-0">
                    <div class="text-center mb-3">
                        <small class="text-muted fw-bold" style="letter-spacing: 1px;">TRANSACTION DETAILS</small>
                    </div>

                    <div class="type-toggle">
                        <input type="radio" id="toggleExpense" name="txType" value="Expense" checked onchange="toggleModalType()">
                        <label for="toggleExpense">Expense</label>
                        
                        <input type="radio" id="toggleIncome" name="txType" value="Income" onchange="toggleModalType()">
                        <label for="toggleIncome">Income</label>
                        
                        <input type="radio" id="toggleTransfer" name="txType" value="Transfer" onchange="toggleModalType()">
                        <label for="toggleTransfer">Transfer</label>
                    </div>

                    <div class="form-group-custom">
                        <input type="number" id="modalAmount" class="form-control-custom fs-3 mb-3 text-dark fw-bold" placeholder="0" />
                    </div>

                    <div class="form-group-custom d-flex justify-content-between align-items-center border-bottom pb-2">
                        <label class="mb-0 text-muted">Category</label>
                        <select id="modalCategory" class="form-control-custom w-auto text-end p-0 bg-transparent text-dark shadow-none">
                            @foreach(var c in categories)
                            {
                                <option value="@c.Name">@c.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group-custom d-flex justify-content-between align-items-center border-bottom pb-2" id="modalDestContainer" style="display:none;">
                        <label class="mb-0 text-muted">Destination</label>
                        <input type="text" id="modalDestination" class="form-control-custom w-50 text-end p-0 bg-transparent text-dark shadow-none" placeholder="e.g. BCA" />
                    </div>

                    <div class="form-group-custom mt-4">
                        <label class="text-muted mb-2">NOTES</label>
                        <textarea id="modalNote" class="form-control-custom" rows="2" placeholder="Add a note..."></textarea>
                    </div>

                    <div class="form-group-custom mt-3 form-check form-switch" id="modalRecurringContainer">
                        <input class="form-check-input" type="checkbox" id="modalRecurring">
                        <label class="form-check-label text-muted fw-bold ms-2" for="modalRecurring">Is this a Recurring Bill?</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            showClass: { popup: 'animate-zoom-in' },
            hideClass: { popup: 'animate-slide-right' }
        });

        window.showToast = function(icon, title) {
            Toast.fire({
                icon: icon,
                title: title
            });
        };

        let globalEditId = 0;

        function toggleSidebar() {
            document.getElementById('appSidebar').classList.toggle('show');
            document.getElementById('sidebarBackdrop').classList.toggle('show');
        }

        // ================= GLOBAL THEME LOGIC =================
        function toggleGlobalTheme() {
            const body = document.body;
            body.classList.toggle("light-mode");
            
            const isLight = body.classList.contains("light-mode");
            localStorage.setItem("lightMode", isLight);
            
            updateThemeIcons(isLight);
        }

        function updateThemeIcons(isLight) {
            const icons = document.querySelectorAll("#globalThemeIcon, #themeIcon");
            icons.forEach(el => {
                el.innerHTML = isLight ? "<ion-icon name='moon-outline'></ion-icon>" : "<ion-icon name='sunny-outline'></ion-icon>";
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const isLight = document.body.classList.contains("light-mode");
            updateThemeIcons(isLight);
        });

        function resetModalForm() {
            globalEditId = 0;
            document.getElementById('toggleExpense').checked = true;
            document.getElementById('modalAmount').value = '';
            document.getElementById('modalNote').value = '';
            document.getElementById('modalDestination').value = '';
            document.getElementById('modalRecurring').checked = false;
            toggleModalType();
        }

        function populateModalForm(id, type, amount, category, note, destination, isRecurring) {
            globalEditId = id;
            if (type === 'Expense') document.getElementById('toggleExpense').checked = true;
            else if (type === 'Transfer') document.getElementById('toggleTransfer').checked = true;
            else document.getElementById('toggleIncome').checked = true;
            
            document.getElementById('modalAmount').value = amount;
            document.getElementById('modalCategory').value = category;
            document.getElementById('modalNote').value = note || "";
            document.getElementById('modalDestination').value = destination || "";
            document.getElementById('modalRecurring').checked = isRecurring === true || isRecurring === 'true';
            
            toggleModalType();
            
            const modal = new bootstrap.Modal(document.getElementById('addTransactionModal'));
            modal.show();
        }

        function toggleModalType() {
            const isExpense = document.getElementById('toggleExpense').checked;
            const isTransfer = document.getElementById('toggleTransfer').checked;
            const amountInput = document.getElementById('modalAmount');
            
            if (isExpense) {
                amountInput.style.color = 'var(--text-dark)';
            } else if (isTransfer) {
                amountInput.style.color = 'var(--text-dark)';
            } else {
                amountInput.style.color = 'var(--primary-green)';
            }

            document.getElementById('modalDestContainer').style.display = isTransfer ? 'flex' : 'none';
            document.getElementById('modalRecurringContainer').style.display = isExpense ? 'block' : 'none';
        }

        async function saveGlobalTransaction() {
            const type = document.getElementById('toggleExpense').checked ? 'Expense' : 
                         document.getElementById('toggleTransfer').checked ? 'Transfer' : 'Income';
            
            const amount = document.getElementById('modalAmount').value;
            const category = document.getElementById('modalCategory').value;
            const note = document.getElementById('modalNote').value;
            const destination = document.getElementById('modalDestination').value;
            const isRecurring = document.getElementById('modalRecurring').checked;

            if (!amount || parseFloat(amount) <= 0) {
                Swal.fire('Warning', 'Please enter a valid amount.', 'warning');
                return;
            }

            try {
                const response = await fetch('/Transaction/Save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: globalEditId,
                        type: type,
                        category: category,
                        amount: parseFloat(amount),
                        note: note,
                        destination: destination,
                        isRecurring: isRecurring
                    })
                });

                if (!response.ok) throw new Error('Save failed');

                const modalEl = document.getElementById('addTransactionModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                modal.hide();

                showToast("success", "Transaction saved successfully!");
                setTimeout(() => {
                    window.location.reload(); 
                }, 1200);

            } catch (err) {
                console.error(err);
                Swal.fire('Error', 'Failed to save transaction.', 'error');
            }
        }
    </script>

    @if (TempData["LoginSuccess"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                setTimeout(() => {
                    showToast("success", "@TempData["LoginSuccess"]");
                }, 300);
            });
        </script>
    }

    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                setTimeout(() => {
                    showToast("success", "@TempData["Success"]");
                }, 100);
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
    <!-- Ionicons Setup -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>
</html>