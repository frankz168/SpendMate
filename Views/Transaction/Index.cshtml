@{
    ViewBag.Title = "SpendMate";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-4">

    <div class="d-flex justify-content-end mb-2 gap-2">
       <button class="btn btn-sm btn-outline-dark" onclick="toggleDarkMode()">
            🌙 Toggle Dark Mode
        </button>
        <button class="btn btn-sm btn-success" onclick="exportExcel()">⬇️ Export Excel</button>
    </div>

    <div class="mb-4">
        <h2>💸 SpendMate Transactions</h2>
        <p class="text-muted">Manage your income, expenses, and transfers easily.</p>
    </div>

    <div class="card shadow-sm mb-4 border-primary custom-card">
        <div class="card-body">
            <h5 class="card-title text-primary mb-3 fw-bold">➕ Add New Record</h5>
            <div class="row g-3 align-items-end">

                <div class="col-md-2">
                    <label class="fw-bold">Type</label>
                    <select id="type" class="form-select" onchange="toggleType()">
                        <option value="Expense">Expense</option>
                        <option value="Income">Income</option>
                        <option value="Transfer">Transfer</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="fw-bold">Category</label>
                    <select id="category" class="form-select">
                        <option value="Food">🍽️ Food</option>
                        <option value="Transport">🚗 Transport</option>
                        <option value="Shopping">🛍️ Shopping</option>
                        <option value="Salary">💰 Salary</option>
                        <option value="Others">📦 Others</option>
                    </select>
                </div>

                <div class="col-md-2" id="destContainer" style="display:none;">
                    <label class="fw-bold">Destination</label>
                    <input id="destination" class="form-control" placeholder="e.g. BCA, Wife" />
                </div>

                <div class="col-md-2">
                    <label class="fw-bold">Amount (Rp)</label>
                    <input id="amount" type="number" class="form-control" placeholder="50000" min="1" />
                </div>

                <div class="col-md-3">
                    <label class="fw-bold">Note</label>
                    <input id="note" class="form-control" placeholder="Optional notes..." />
                </div>

                <div class="col-md-1 d-grid">
                    <button id="btnSave" class="btn btn-primary fw-bold" onclick="saveTransaction()">SAVE</button>
                </div>

            </div>
            <small class="text-muted mt-2 d-inline-block">* Transactions are automatically recorded using current server time.</small>
        </div>
    </div>

    <div class="card shadow-sm mb-3 custom-card">
        <div class="card-body bg-light rounded">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="text-muted small">From Date</label>
                    <input id="fromDate" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="text-muted small">To Date</label>
                    <input id="toDate" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label class="text-muted small">&nbsp;</label>
                    <div>
                        <button class="btn btn-sm btn-primary" onclick="loadData()">Apply</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="setThisMonth()">This Month</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="setRange(7)">Last 7 Days</button>
                    </div>
                </div>
                <div class="col-md-2 ms-auto">
                    <label class="text-muted small">Search</label>
                    <input id="searchBox" class="form-control form-control-sm" placeholder="Type note/category..." oninput="applyFilter()" />
                </div>
                <div class="col-md-2">
                    <label class="text-muted small">Filter Type</label>
                    <select id="filterType" class="form-select form-select-sm" onchange="applyFilter()">
                        <option value="">All Types</option>
                        <option value="Expense">Expense</option>
                        <option value="Income">Income</option>
                        <option value="Transfer">Transfer</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm custom-card">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3 py-3">Time</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Category/Dest.</th>
                        <th class="py-3">Note</th>
                        <th class="py-3 text-end">Amount (Rp)</th>
                        <th class="py-3 text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="transactionList"></tbody>
                <tfoot class="table-light border-top border-2">
                    <tr>
                        <td colspan="4" class="text-end fw-bold">TOTAL RECORDED:</td>
                        <td class="text-end fw-bold text-primary fs-6" id="totalAmount">Rp 0</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>

            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <button class="btn btn-sm btn-outline-dark" onclick="prevPage()">◀ Prev</button>
                <div id="pageInfo" class="fw-bold"></div>
                <button class="btn btn-sm btn-outline-dark" onclick="nextPage()">Next ▶</button>
            </div>
        </div>
    </div>

</div>

<script>
let editId = 0;
let allData = [];
let filteredData = [];
let currentPage = 1;
const pageSize = 15;

function toggleType() {
    const t = document.getElementById("type").value;
    const dest = document.getElementById("destContainer");
    if(t === "Transfer") {
        dest.style.display = "block";
    } else {
        dest.style.display = "none";
        document.getElementById("destination").value = "";
    }
}

// ================= LOAD DATA =================
async function loadData() {
    const from = document.getElementById("fromDate").value;
    const to = document.getElementById("toDate").value;
    
    let url = '/Transaction/GetData';
    if (from && to) {
        url += `?from=${from}&to=${to}`;
    }

    try {
        const res = await fetch(url);
        const data = await res.json();
        allData = data;
        filteredData = allData;
        currentPage = 1;
        renderTable();
    } catch(err) {
        console.error("Failed to load data", err);
    }
}

// ================= RENDER & FILTER =================
function applyFilter() {
    const search = document.getElementById("searchBox").value.toLowerCase();
    const type = document.getElementById("filterType").value;
    
    filteredData = allData.filter(x =>
        ((x.note ?? "").toLowerCase().includes(search) ||
         (x.category ?? "").toLowerCase().includes(search) ||
         (x.destination ?? "").toLowerCase().includes(search)) &&
        (!type || x.type === type)
    );
    currentPage = 1;
    renderTable();
}

function renderTable() {
    const start = (currentPage - 1) * pageSize;
    const pageData = filteredData.slice(start, start + pageSize);

    let rows = "";
    let total = 0;

    filteredData.forEach(x => total += x.amount);

    if (pageData.length === 0) {
        rows = `<tr><td colspan="6" class="text-center text-muted py-5">
            <div class="fs-1 mb-2">📭</div>
            No transactions found.
        </td></tr>`;
    } else {
        pageData.forEach(x => {
            let badgeColor = x.type === "Income" ? "bg-success" : (x.type === "Transfer" ? "bg-info text-dark" : "bg-danger");
            let catDest = x.type === "Transfer" && x.destination ? `${icon(x.category)} ${x.destination}` : `${icon(x.category)} ${x.category}`;

            rows += `
            <tr class="align-middle">
                <td class="ps-3 text-muted">${formatTime(x.createdate)}</td>
                <td><span class="badge ${badgeColor}">${x.type}</span></td>
                <td class="fw-semibold">${catDest}</td>
                <td class="text-muted text-truncate" style="max-width:150px">${x.note ?? "-"}</td>
                <td class="text-end font-monospace fw-bold">Rp ${format(x.amount)}</td>
                <td class="text-center">
                    <button class="btn btn-sm btn-light shadow-sm text-warning mx-1" onclick="editTransaction(${x.id})">✏️</button>
                    <button class="btn btn-sm btn-light shadow-sm text-danger mx-1" onclick="deleteTransaction(${x.id})">🗑️</button>
                </td>
            </tr>`;
        });
    }

    document.getElementById("transactionList").innerHTML = rows;
    document.getElementById("totalAmount").innerText = `Rp ${format(total)}`;
    updatePageInfo();
}

// ================= DATE RANGE =================
function setThisMonth() {
    const date = new Date();
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    
    const firstDay = `${y}-${m}-01`;
    const nextMonth = new Date(y, date.getMonth() + 1, 1);
    const lastDay = nextMonth.toISOString().split('T')[0];

    document.getElementById("fromDate").value = firstDay;
    document.getElementById("toDate").value = lastDay;
    loadData();
}

function setRange(days) {
    const today = new Date();
    const from = new Date();
    from.setDate(today.getDate() - days);
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);

    document.getElementById("fromDate").value = from.toISOString().split('T')[0];
    document.getElementById("toDate").value = tomorrow.toISOString().split('T')[0];
    loadData();
}

// ================= CRUD =================
async function saveTransaction() {
    const type = document.getElementById("type").value;
    const category = document.getElementById("category").value;
    const amount = document.getElementById("amount").value;
    const note = document.getElementById("note").value;
    const destination = document.getElementById("destination").value;

    if (!category || !amount || parseFloat(amount) <= 0) {
        Swal.fire({
            icon: "warning",
            title: "Incomplete Data",
            text: "Category is required and Amount must be greater than 0"
        });
        return;
    }

    try {
        const response = await fetch('/Transaction/Save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                id: editId,
                type: type,
                category: category,
                destination: destination,
                amount: parseFloat(amount),
                note: note
            })
        });

        if (!response.ok) throw new Error("Server error");

        Swal.fire({
            icon: "success",
            title: editId ? "Updated!" : "Saved!",
            timer: 1500,
            showConfirmButton: false
        });
        
        resetForm();
        loadData();

    } catch (err) {
        Swal.fire("Error", "Failed to save transaction", "error");
        console.error("SAVE ERROR:", err);
    }
}

async function editTransaction(id) {
    try {
        const res = await fetch('/Transaction/GetById?id=' + id);
        const x = await res.json();

        editId = x.id;
        document.getElementById("type").value = x.type;
        toggleType();
        document.getElementById("category").value = x.category;
        document.getElementById("destination").value = x.destination ?? "";
        document.getElementById("amount").value = x.amount;
        document.getElementById("note").value = x.note;
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
        Swal.fire("Error", "Failed to load data", "error");
    }
}

async function deleteTransaction(id) {
    const confirm = await Swal.fire({
        title: "Delete Transaction?",
        text: "This action cannot be undone.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
    });

    if (!confirm.isConfirmed) return;

    try {
        await fetch('/Transaction/Delete?id=' + id, { method: 'POST' });
        Swal.fire({ icon: "success", title: "Deleted", timer: 1000, showConfirmButton: false });
        loadData();
    } catch (err) {
        Swal.fire("Error", "Failed to delete data", "error");
    }
}

// ================= HELPERS =================
function format(num) {
    return new Intl.NumberFormat('id-ID').format(num || 0);
}

function formatTime(date) {
    if (!date) return "-";
    let safeDate = typeof date === "string" ? date.replace(" ", "T") : date;
    const d = new Date(safeDate);
    if (isNaN(d)) return date;
    
    return d.toLocaleString('en-US', { 
        day: '2-digit', month: 'short', year: 'numeric',
        hour: '2-digit', minute: '2-digit', hour12: false
    });
}

function icon(cat) {
    return cat === "Food" ? "🍽️" : cat === "Transport" ? "🚗" : cat === "Shopping" ? "🛍️" : cat === "Salary" ? "💰" : "📦";
}

function resetForm() {
    editId = 0;
    document.getElementById("type").value = "Expense";
    toggleType();
    document.getElementById("category").value = "Food";
    document.getElementById("amount").value = "";
    document.getElementById("note").value = "";
    document.getElementById("destination").value = "";
    document.getElementById("type").focus();
}

function exportExcel() {
    const from = document.getElementById("fromDate").value;
    const to = document.getElementById("toDate").value;
    let url = '/Transaction/ExportExcel';
    if (from && to) url += `?from=${from}&to=${to}`;
    window.location.href = url;
}

// ================= PAGINATION =================
function nextPage() { 
    if (currentPage * pageSize < filteredData.length) { 
        currentPage++; renderTable(); 
    } 
}
function prevPage() { 
    if (currentPage > 1) { 
        currentPage--; renderTable(); 
    } 
}
function updatePageInfo() { 
    document.getElementById("pageInfo").innerText = `Page ${currentPage} of ${Math.ceil(filteredData.length / pageSize) || 1}`; 
}

// ================= INIT =================
setThisMonth(); 

// ================= DARK MODE =================
function toggleDarkMode() {
    document.body.classList.toggle("dark-mode");
    localStorage.setItem("darkMode", document.body.classList.contains("dark-mode"));
}
if (localStorage.getItem("darkMode") === "true") { 
    document.body.classList.add("dark-mode"); 
}
</script>

<style>
    /* Premium Look */
    .custom-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .btn-light {
        background: #f8f9fa;
        border: none;
    }
    .btn-light:hover {
        background: #e2e6ea;
    }

    /* Dark Mode Styling */
    body.dark-mode { background: #121212; color: #eaeaea; }
    body.dark-mode .card { background: #1e1e1e; border-color: #333; }
    body.dark-mode .table { color: #eaeaea; }
    body.dark-mode .table-dark { background-color: #000; border-color: #444; }
    body.dark-mode .table-light { background-color: #2a2a2a; color: #eaeaea; border-color: #444; }
    body.dark-mode .table-hover tbody tr:hover { background-color: #252525; color: white; }
    body.dark-mode input, body.dark-mode select { background-color: #333; color: white; border-color: #555; }
    body.dark-mode input:focus, body.dark-mode select:focus { background-color: #444; color: white; border-color: #0d6efd; }
    body.dark-mode .text-muted { color: #adb5bd !important; }
    body.dark-mode .btn-light { background: #333; color: #eaeaea; }
    body.dark-mode .btn-light:hover { background: #444; }
</style>