@{
    ViewBag.Title = "SpendMate";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-between align-items-center mt-2 mb-4">
    <div class="page-title mb-0 d-flex align-items-center"><ion-icon name="cash-outline" class="me-2"></ion-icon> All Transactions</div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm fw-bold shadow-sm d-flex align-items-center gap-1" style="background-color: rgba(255,255,255,0.1); color: var(--text-dark); border-radius: 8px;" onclick="exportExcel()">
            <ion-icon name="download-outline"></ion-icon> Export Excel
        </button>
    </div>
</div>

<p class="text-muted mb-4">Manage your income, expenses, and transfers easily.</p>

<!-- FILTERS -->
<div class="theme-card mb-4 p-3" style="padding-bottom: 12px !important;">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="text-muted small fw-bold mb-1">From Date</label>
            <input id="fromDate" type="date" class="form-control-custom shadow-none border" style="padding: 8px 12px;" />
        </div>
        <div class="col-md-2">
            <label class="text-muted small fw-bold mb-1">To Date</label>
            <input id="toDate" type="date" class="form-control-custom shadow-none border" style="padding: 8px 12px;" />
        </div>
        <div class="col-md-4">
            <div class="d-flex gap-2">
                <button class="btn text-white fw-bold shadow-sm" style="background-color: var(--primary-accent); border-radius: 8px;" onclick="loadData()">Apply</button>
                <button class="btn fw-bold shadow-sm border" style="background-color: rgba(255,255,255,0.1); color: var(--text-dark); border-color: var(--border-color) !important; border-radius: 8px;" onclick="setThisMonth()">This Month</button>
                <button class="btn fw-bold shadow-sm border" style="background-color: rgba(255,255,255,0.1); color: var(--text-dark); border-color: var(--border-color) !important; border-radius: 8px;" onclick="setRange(7)">Last 7 Days</button>
            </div>
        </div>
        <div class="col-md-2 ms-auto">
            <label class="text-muted small fw-bold mb-1">Search</label>
            <input id="searchBox" class="form-control-custom shadow-none border" style="padding: 8px 12px;" placeholder="Type note..." oninput="applyFilter()" />
        </div>
        <div class="col-md-2">
            <label class="text-muted small fw-bold mb-1">Filter Type</label>
            <select id="filterType" class="form-control-custom shadow-none border" style="padding: 8px 12px;" onchange="applyFilter()">
                <option value="">All Types</option>
                <option value="Expense">Expense</option>
                <option value="Income">Income</option>
                <option value="Transfer">Transfer</option>
            </select>
        </div>
    </div>
</div>

<!-- TRANSACTION TABLE -->
<div class="theme-card p-0 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table align-middle mb-0 border-0">
            <thead style="background-color: rgba(255, 255, 255, 0.05); border-bottom: 2px solid var(--border-color);">
                <tr>
                    <th class="border-0 text-muted ps-4 py-3" style="font-weight: 600; font-size: 13px;">Time</th>
                    <th class="border-0 text-muted py-3" style="font-weight: 600; font-size: 13px;">Type</th>
                    <th class="border-0 text-muted py-3" style="font-weight: 600; font-size: 13px;">Category/Dest.</th>
                    <th class="border-0 text-muted py-3" style="font-weight: 600; font-size: 13px;">Note</th>
                    <th class="border-0 text-muted text-end py-3" style="font-weight: 600; font-size: 13px;">Amount (Rp)</th>
                    <th class="border-0 text-muted text-center py-3 pe-4" style="font-weight: 600; font-size: 13px;">Action</th>
                </tr>
            </thead>
            <tbody id="transactionList"></tbody>
            <tfoot style="background-color: rgba(255, 255, 255, 0.05); border-top: 2px solid var(--border-color);">
                <tr>
                    <td colspan="4" class="text-end fw-bold py-3" style="color: var(--text-dark);">TOTAL RECORDED:</td>
                    <td class="text-end fw-bold py-3" style="color: var(--primary-accent) !important;" id="totalAmount">Rp 0</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- PAGINATION -->
    <div class="d-flex justify-content-between align-items-center p-3 border-top" style="border-color: var(--border-color) !important;">
        <button class="btn btn-sm fw-bold border shadow-sm" style="background-color: rgba(255,255,255,0.1); color: var(--text-dark); border-color: var(--border-color) !important; border-radius: 8px;" onclick="prevPage()">◀ Prev</button>
        <div id="pageInfo" class="fw-bold" style="color: var(--text-dark);"></div>
        <button class="btn btn-sm fw-bold border shadow-sm" style="background-color: rgba(255,255,255,0.1); color: var(--text-dark); border-color: var(--border-color) !important; border-radius: 8px;" onclick="nextPage()">Next ▶</button>
    </div>
</div>

<script>
let editId = 0;
let allData = [];
let filteredData = [];
let currentPage = 1;
const pageSize = 15;

// ================= LOAD DATA =================
async function loadData() {
    const from = document.getElementById("fromDate").value;
    const to = document.getElementById("toDate").value;
    
    let url = '/Transaction/GetData';
    if (from && to) {
        url += `?from=${from}&to=${to}`;
    }

    try {
        const res = await fetch(url);
        const data = await res.json();
        allData = data;
        filteredData = allData;
        currentPage = 1;
        renderTable();
    } catch(err) {
        console.error("Failed to load data", err);
    }
}

// ================= RENDER & FILTER =================
function applyFilter() {
    const search = document.getElementById("searchBox").value.toLowerCase();
    const type = document.getElementById("filterType").value;
    
    filteredData = allData.filter(x =>
        ((x.note ?? "").toLowerCase().includes(search) ||
         (x.category ?? "").toLowerCase().includes(search) ||
         (x.destination ?? "").toLowerCase().includes(search)) &&
        (!type || x.type === type)
    );
    currentPage = 1;
    renderTable();
}

function renderTable() {
    const start = (currentPage - 1) * pageSize;
    const pageData = filteredData.slice(start, start + pageSize);

    let rows = "";
    let total = 0;

    filteredData.forEach(x => total += x.amount);

    if (pageData.length === 0) {
        rows = `<tr><td colspan="6" class="text-center text-muted py-5">
            <div class="fs-1 mb-2 d-flex justify-content-center"><ion-icon name="document-text-outline"></ion-icon></div>
            No transactions found.
        </td></tr>`;
    } else {
        pageData.forEach(x => {
            let badgeBg = x.type === "Income" ? "rgba(16, 185, 129, 0.1)" : (x.type === "Transfer" ? "#e0f2fe" : "rgba(239, 68, 68, 0.1)");
            let badgeColor = x.type === "Income" ? "var(--primary-green)" : (x.type === "Transfer" ? "#0284c7" : "var(--danger-red)");
            let catDest = x.type === "Transfer" && x.destination ? `${icon(x.category)} ${x.destination}` : `${icon(x.category)} ${x.category}`;

            rows += `
            <tr class="align-middle border-bottom" style="border-color: var(--border-color) !important; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#f8fafc'" onmouseout="this.style.backgroundColor='transparent'">
                <td class="ps-4 text-muted fw-semibold" style="font-size: 13px;">${formatTime(x.createdate)}</td>
                <td>
                    <span class="fw-bold" style="background-color: ${badgeBg}; color: ${badgeColor}; padding: 4px 10px; border-radius: 6px; font-size: 12px;">
                        ${x.type}
                    </span>
                </td>
                <td class="fw-bold" style="color: var(--text-dark);">${catDest}</td>
                <td class="text-muted text-truncate" style="max-width:150px">${x.note ?? "-"}</td>
                <td class="text-end fw-bold" style="color: ${badgeColor};">Rp ${format(x.amount)}</td>
                <td class="text-center pe-4">
                    <button class="btn btn-sm btn-light shadow-sm text-warning fw-bold mx-1 d-inline-flex align-items-center" style="border-radius: 6px;" onclick="editTransaction(${x.id})">
                        <ion-icon name="create-outline"></ion-icon>
                    </button>
                    <button class="btn btn-sm btn-light shadow-sm text-danger fw-bold mx-1 d-inline-flex align-items-center" style="border-radius: 6px;" onclick="deleteTransaction(${x.id})">
                        <ion-icon name="trash-outline"></ion-icon>
                    </button>
                </td>
            </tr>`;
        });
    }

    document.getElementById("transactionList").innerHTML = rows;
    document.getElementById("totalAmount").innerText = `Rp ${format(total)}`;
    updatePageInfo();
}

// ================= DATE RANGE =================
function setThisMonth() {
    const date = new Date();
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    
    const firstDay = `${y}-${m}-01`;
    const nextMonth = new Date(y, date.getMonth() + 1, 1);
    const lastDay = nextMonth.toISOString().split('T')[0];

    document.getElementById("fromDate").value = firstDay;
    document.getElementById("toDate").value = lastDay;
    loadData();
}

function setRange(days) {
    const today = new Date();
    const from = new Date();
    from.setDate(today.getDate() - days);
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);

    document.getElementById("fromDate").value = from.toISOString().split('T')[0];
    document.getElementById("toDate").value = tomorrow.toISOString().split('T')[0];
    loadData();
}

// ================= CRUD =================
async function editTransaction(id) {
    try {
        const res = await fetch('/Transaction/GetById?id=' + id);
        const x = await res.json();
        
        if (typeof populateModalForm === 'function') {
            populateModalForm(x.id, x.type, x.amount, x.category, x.note, x.destination, x.isRecurring);
        } else {
            console.error("populateModalForm function not found in layout.");
        }
    } catch (err) {
        Swal.fire("Error", "Failed to load data", "error");
    }
}

async function deleteTransaction(id) {
    const confirm = await Swal.fire({
        title: "Delete Transaction?",
        text: "This action cannot be undone.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#ef4444",
        confirmButtonText: "Yes, delete it!"
    });

    if (!confirm.isConfirmed) return;

    try {
        await fetch('/Transaction/Delete?id=' + id, { method: 'POST' });
        showToast("success", "Transaction deleted!");
        loadData();
    } catch (err) {
        Swal.fire("Error", "Failed to delete data", "error");
    }
}

// ================= HELPERS =================
function format(num) {
    return new Intl.NumberFormat('id-ID').format(num || 0);
}

function formatTime(date) {
    if (!date) return "-";
    let safeDate = typeof date === "string" ? date.replace(" ", "T") : date;
    const d = new Date(safeDate);
    if (isNaN(d)) return date;
    
    return d.toLocaleString('en-US', { 
        day: '2-digit', month: 'short', year: 'numeric',
        hour: '2-digit', minute: '2-digit', hour12: false
    });
}

function icon(cat) {
    if (!cat) return "<ion-icon name=\"cube-outline\"></ion-icon>";
    cat = cat.toUpperCase();
    if (cat.includes("DINING") || cat.includes("FOOD") || cat.includes("EAT")) return "<ion-icon name=\"restaurant-outline\"></ion-icon>";
    if (cat.includes("TRANSPORT") || cat.includes("GAS") || cat.includes("CAR")) return "<ion-icon name=\"car-outline\"></ion-icon>";
    if (cat.includes("SHOPPING")) return "<ion-icon name=\"bag-handle-outline\"></ion-icon>";
    if (cat.includes("GROCERIES") || cat.includes("GROCERY")) return "<ion-icon name=\"cart-outline\"></ion-icon>";
    if (cat.includes("ELECTRIC") || cat.includes("PLN")) return "<ion-icon name=\"flash-outline\"></ion-icon>";
    if (cat.includes("WATER") || cat.includes("PAM")) return "<ion-icon name=\"water-outline\"></ion-icon>";
    if (cat.includes("PARENTS") || cat.includes("FAMILY")) return "<ion-icon name=\"people-outline\"></ion-icon>";
    if (cat.includes("INTERNET") || cat.includes("KUOTA") || cat.includes("WIFI")) return "<ion-icon name=\"wifi-outline\"></ion-icon>";
    if (cat.includes("LAUNDRY") || cat.includes("WASH")) return "<ion-icon name=\"shirt-outline\"></ion-icon>";
    if (cat.includes("TABUNGAN") || cat.includes("INVEST") || cat.includes("DANA")) return "<ion-icon name=\"trending-up-outline\"></ion-icon>";
    if (cat.includes("ENSURANCE") || cat.includes("INSURANCE")) return "<ion-icon name=\"shield-checkmark-outline\"></ion-icon>";
    if (cat.includes("KAKAVEST")) return "<ion-icon name=\"wallet-outline\"></ion-icon>";
    if (cat.includes("GOLD") || cat.includes("ANTAM")) return "<ion-icon name=\"medal-outline\"></ion-icon>";
    if (cat.includes("RECREATION") || cat.includes("HOLIDAY") || cat.includes("VACATION")) return "<ion-icon name=\"airplane-outline\"></ion-icon>";
    if (cat.includes("SALARY") || cat.includes("INCOME")) return "<ion-icon name=\"cash-outline\"></ion-icon>";
    if (cat.includes("BONUS") || cat.includes("GIFT")) return "<ion-icon name=\"gift-outline\"></ion-icon>";
    return "<ion-icon name=\"cube-outline\"></ion-icon>";
}

function exportExcel() {
    const from = document.getElementById("fromDate").value;
    const to = document.getElementById("toDate").value;
    let url = '/Transaction/ExportExcel';
    if (from && to) url += `?from=${from}&to=${to}`;
    window.location.href = url;
}

// ================= PAGINATION =================
function nextPage() { 
    if (currentPage * pageSize < filteredData.length) { 
        currentPage++; renderTable(); 
    } 
}
function prevPage() { 
    if (currentPage > 1) { 
        currentPage--; renderTable(); 
    } 
}
function updatePageInfo() { 
    document.getElementById("pageInfo").innerText = `Page ${currentPage} of ${Math.ceil(filteredData.length / pageSize) || 1}`; 
}

// ================= INIT =================
setThisMonth(); 
</script>