@model IEnumerable<Transaction>

@{
    ViewBag.Title = "Transactions List";

    var list = Model?.ToList() ?? new List<Transaction>();
    var totalAmount = list.Sum(x => x.Amount);
    var totalCount = list.Count;
    var currentCategory = ViewBag.Category as string ?? "All Categories";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary mb-2 rounded-pill px-3 shadow-sm d-inline-flex align-items-center">
                <ion-icon name="arrow-back-outline" class="me-1"></ion-icon> Back to Dashboard
            </a>
            <h2 class="fw-bold mb-1 d-flex align-items-center"><ion-icon name="document-text-outline" class="me-2"></ion-icon> Transactions</h2>
            <p class="text-muted mb-0">
                Viewing records for: <span class="badge bg-primary fs-6 ms-1 shadow-sm">@currentCategory</span>
            </p>
        </div>
    </div>

    <div class="card shadow-sm theme-card mb-4 border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 border-0 text-muted">Date & Time</th>
                            <th class="py-3 border-0 text-muted">Type</th>
                            <th class="py-3 border-0 text-muted">Category / Dest.</th>
                            <th class="py-3 border-0 text-muted">Note</th>
                            <th class="pe-4 py-3 border-0 text-end text-muted">Amount (Rp)</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (list.Count > 0)
                    {
                        foreach (var x in list)
                        {
                            <tr onclick="openDetail(@x.Id)" class="transition-row" style="cursor:pointer" title="Click to view details">
                                <td class="ps-4 py-3 text-muted">@x.Createdate.ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="py-3">
                                    <span class="badge @GetTypeBadge(x.Type)">@x.Type</span>
                                </td>
                                <td class="py-3 fw-semibold">
                                    <span class="fs-5 me-2 d-inline-flex" style="vertical-align: -2px;">@Html.Raw(GetIcon(x.Category))</span> @(x.Type == "Transfer" && !string.IsNullOrEmpty(x.Destination) ? x.Destination : x.Category)
                                </td>
                                <td class="py-3 text-muted text-truncate" style="max-width: 200px;">
                                    @(string.IsNullOrEmpty(x.Note) ? "-" : x.Note)
                                </td>
                                <td class="pe-4 py-3 text-end fw-bold font-monospace">
                                    @x.Amount.ToString("N0")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <div class="fs-1 mb-2 d-flex justify-content-center"><ion-icon name="document-text-outline"></ion-icon></div>
                                <h5 class="fw-bold">No transactions found</h5>
                                <p class="mb-0">Try adjusting your filters or date range.</p>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="theme-card summary-card mt-3">
        <div class="d-flex justify-content-between align-items-center px-2 py-1">
            <div>
                <span class="text-muted d-block" style="font-size: 0.85rem;">Total Transactions</span>
                <span class="fw-bold fs-5">@totalCount <small class="text-muted fw-normal">items</small></span>
            </div>
            <div class="text-end">
                <span class="text-muted d-block" style="font-size: 0.85rem;">Total Amount</span>
                <span class="fw-bold text-primary fs-4 font-monospace">
                    Rp @totalAmount.ToString("N0")
                </span>
            </div>
        </div>
    </div>

</div>

<script>
    // BEAUTIFUL DETAIL MODAL
    function openDetail(id) {
        fetch(`/Transaction/GetById?id=${id}`)
            .then(r => r.json())
            .then(d => {
                const formattedAmount = new Intl.NumberFormat('id-ID').format(d.amount);
                const safeNote = d.note ? d.note : '<em class="text-muted">No additional notes</em>';
                const formattedDate = new Date(d.createdate).toLocaleString('en-GB', { 
                    day: 'numeric', month: 'short', year: 'numeric', 
                    hour: '2-digit', minute: '2-digit' 
                });
                
                let icon = d.category === "Food" || d.category === "Dining" ? "<ion-icon name='restaurant-outline'></ion-icon>" : 
                           d.category === "Transport" ? "<ion-icon name='car-outline'></ion-icon>" : 
                           d.category === "Shopping" ? "<ion-icon name='bag-handle-outline'></ion-icon>" : 
                           "<ion-icon name='cube-outline'></ion-icon>";

                Swal.fire({
                    title: `<span class="fs-2 d-flex justify-content-center">${icon}</span><br/>${d.type === 'Transfer' ? d.destination : d.category}`,
                    html: `
                        <div class="text-start mt-3 p-3 bg-light rounded border dark-mode-swal-box">
                            <div class="mb-2 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted fw-bold">Type</span>
                                <span class="fw-bold">${d.type}</span>
                            </div>
                            <div class="mb-2 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted fw-bold">Date</span>
                                <span>${formattedDate}</span>
                            </div>
                            <div class="mb-2 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted fw-bold">Amount</span>
                                <span class="fw-bold text-primary font-monospace fs-5">Rp ${formattedAmount}</span>
                            </div>
                            <div class="mt-3">
                                <span class="text-muted fw-bold d-block mb-1">Note:</span>
                                <span>${safeNote}</span>
                            </div>
                        </div>
                    `,
                    confirmButtonColor: '#0d6efd',
                    confirmButtonText: 'Close'
                });
            })
            .catch(err => {
                Swal.fire("Error", "Failed to load transaction details.", "error");
            });
    }

</script>

<style>
    /* BASE TRANSITIONS */
    body { transition: background-color 0.3s ease, color 0.3s ease; }
    .theme-card { transition: background-color 0.3s ease, border-color 0.3s ease; border-radius: 12px; }
    .transition-row { transition: background-color 0.2s ease; }
</style>

@functions {
    public string GetIcon(string category)
    {
        var cat = category?.ToUpperInvariant() ?? "";
        if (cat.Contains("DINING") || cat.Contains("FOOD") || cat.Contains("EAT")) return "<ion-icon name=\"restaurant-outline\"></ion-icon>";
        if (cat.Contains("TRANSPORT") || cat.Contains("GAS") || cat.Contains("CAR")) return "<ion-icon name=\"car-outline\"></ion-icon>";
        if (cat.Contains("SHOPPING")) return "<ion-icon name=\"bag-handle-outline\"></ion-icon>";
        if (cat.Contains("GROCERIES") || cat.Contains("GROCERY")) return "<ion-icon name=\"cart-outline\"></ion-icon>";
        if (cat.Contains("ELECTRIC") || cat.Contains("PLN")) return "<ion-icon name=\"flash-outline\"></ion-icon>";
        if (cat.Contains("WATER") || cat.Contains("PAM")) return "<ion-icon name=\"water-outline\"></ion-icon>";
        if (cat.Contains("PARENTS") || cat.Contains("FAMILY")) return "<ion-icon name=\"people-outline\"></ion-icon>";
        if (cat.Contains("INTERNET") || cat.Contains("KUOTA") || cat.Contains("WIFI")) return "<ion-icon name=\"wifi-outline\"></ion-icon>";
        if (cat.Contains("LAUNDRY") || cat.Contains("WASH")) return "<ion-icon name=\"shirt-outline\"></ion-icon>";
        if (cat.Contains("TABUNGAN") || cat.Contains("INVEST") || cat.Contains("DANA")) return "<ion-icon name=\"trending-up-outline\"></ion-icon>";
        if (cat.Contains("ENSURANCE") || cat.Contains("INSURANCE")) return "<ion-icon name=\"shield-checkmark-outline\"></ion-icon>";
        if (cat.Contains("KAKAVEST")) return "<ion-icon name=\"wallet-outline\"></ion-icon>";
        if (cat.Contains("GOLD") || cat.Contains("ANTAM")) return "<ion-icon name=\"medal-outline\"></ion-icon>";
        if (cat.Contains("RECREATION") || cat.Contains("HOLIDAY") || cat.Contains("VACATION")) return "<ion-icon name=\"airplane-outline\"></ion-icon>";
        if (cat.Contains("SALARY") || cat.Contains("INCOME")) return "<ion-icon name=\"cash-outline\"></ion-icon>";
        if (cat.Contains("BONUS") || cat.Contains("GIFT")) return "<ion-icon name=\"gift-outline\"></ion-icon>";
        return "<ion-icon name=\"cube-outline\"></ion-icon>";
    }
    public string GetTypeBadge(string type)
    {
        return type switch
        {
            "Income" => "bg-success",
            "Expense" => "bg-danger",
            "Transfer" => "bg-info",
            _ => "bg-secondary"
        };
    }
}